# Copy this file to .env and fill in the values.

# Postgres connection string (Supabase transaction pooler, or a local Postgres).
# Schema and data loading: data/db/README.md
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# PEM of the Supabase root certificate (Dashboard > Database > SSL
# Configuration). When set, the database certificate is verified. On one
# line, write the line breaks as \n.
DATABASE_CA_CERT=
DATA_MODE=sql
PORT=3000

# AI analysis of a listing (optional: without a key the score is shown alone).
# Any OpenAI-compatible endpoint, e.g. the Workers AI Worker in cloudflare/ai:
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=@cf/openai/gpt-oss-20b
# ...or OpenAI directly (uses gpt-4o-mini):
OPENAI_API_KEY=

# Shared with the Cloudflare relay Worker so the backend trusts the visitor IP
# it forwards (see cloudflare/README.md). Required in production; several
# comma-separated values are accepted during a rotation. Leave empty locally.
RELAY_SECRET=

# Optional tuning
# SCORE_LIMIT_PER_MINUTE=10
# SCORE_LIMIT_PER_DAY=60
# API_LIMIT_PER_MINUTE=120
# AI_DAILY_CALL_LIMIT=500
# READ_CACHE_TTL_MS=600000
# DB_POOL_MAX=5
# TRUST_PROXY_HOPS=1
